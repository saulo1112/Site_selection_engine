# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Jupyter
.ipynb_checkpoints/

# Secrets / env
.env

# Data (do not version heavy content; structure is preserved via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# EXCEPTION — SERVING artifacts (small, KB-sized): versioned so the API
# (Docker/Render) and the UI (Streamlit Cloud) can run without running the ETL.
# Decision documented in docs/despliegue.md ("Versioned serving artifacts").
!data/processed/mcda_ranking.parquet
!data/processed/lookalike_v2_ranking.parquet
!data/processed/lookalike_v3_ranking.parquet
!data/processed/lookalike_v4_ranking.parquet
!data/processed/lookalike_v2.joblib
!data/processed/lookalike_v3.joblib
!data/processed/lookalike_v4.joblib
# POIs (GeoJSON) for the map overlays.
!data/raw/pois_d1.geojson
!data/raw/pois_competidores.geojson
!data/raw/pois_complementarios.geojson

# Real Streamlit secrets (use secrets.toml.example as a template).
.streamlit/secrets.toml
